{
  "name": "arc-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3107",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3107",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "eval:discovery-rank": "tsx scripts/eval-discovery-rank.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:watch": "tsx scripts/ingest.ts --watch",
    "radar": "tsx scripts/radar.ts",
    "radar:watch": "tsx scripts/radar.ts --watch",
    "theses:watch": "tsx scripts/thesis-worker.ts --watch",
    "backup": "tsx scripts/backup.ts",
    "test:contracts": "forge test --root contracts",
    "test:strategy": "forge test --root contracts/sandbox",
    "test:lifecycle": "forge build --root contracts && tsx scripts/test-hunter-lifecycle.ts",
    "hunter:settle": "tsx scripts/settle-hunter.ts",
    "test:agent": "tsx scripts/test-agent-client.ts",
    "check:integrations": "tsx scripts/check-integrations.ts",
    "check:hosting": "tsx scripts/check-hosting-readiness.ts",
    "workers": "tsx scripts/workers.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.40.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "ws@^8.0.0": "^8.21.3",
    "decode-uri-component": "^0.5.0"
  }
}
