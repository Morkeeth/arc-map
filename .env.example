# Optional future Graph provider. No credentials are needed for explorer discovery.
# This URL must implement the token schema documented in docs/ARCHITECTURE.md.
GRAPH_SUBGRAPH_URL=
GRAPH_API_KEY=
# Optional future Privy wallet flow; not connected in the first slice.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3107

# Transfer-query schema is subgraphs/arcmap/schema.graphql, not the discovery token schema above.
GRAPH_TRANSFERS_URL=
ARC_RPC_URL=https://rpc.testnet.arc.network
# Populate only after an explicitly authorized Arc testnet deployment.
HUNTER_ESCROW_ADDRESS=
HUNTER_ESCROW_CODE_HASH=
HUNTER_EXECUTOR_ADDRESS=
HUNTER_SERVICE_ADDRESS=
# Dedicated service signer, NEVER the user's saved wallet key. Operator CLI only.
HUNTER_EXECUTOR_PRIVATE_KEY=
# Server-side MCP access; agents share this token's private mission workspace.
ARCMAP_AGENT_TOKEN=
